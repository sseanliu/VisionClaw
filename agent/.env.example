# VisionClaw Agent Worker Environment Variables

# LiveKit connection (required for all engines)
LIVEKIT_URL=wss://your-livekit.example.com
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Gemini Live (default realtime engine)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_VOICE=Puck

# OpenAI Realtime (optional realtime engine)
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# VisionClaw gateway (tool execution backend)
GATEWAY_URL=https://your-gateway.example.com
GATEWAY_SERVICE_TOKEN=your-service-token

# OpenClaw direct engine (optional)
# When engine="openclaw" is selected, the agent uses OpenClaw's
# /v1/chat/completions endpoint instead of a realtime model.
# Speech → Google STT → OpenClaw LLM → Google TTS → speech.
# The session key routes to a specific Wembassy agent.
OPENCLAW_URL=https://openclaw.wembassy.com
OPENCLAW_TOKEN=your-openclaw-gateway-token
# Default session key if not provided by the app
OPENCLAW_SESSION_KEY=agent:coo:glass

# Agent behavior
AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=low
SPAWN_MODE=true
QUICK_ANSWER_TIMEOUT_MS=30000

# Quick search (grounded Google search)
QUICK_SEARCH_MODEL=gemini-3.5-flash-lite