// Copy this file to Secrets.kt and fill in your values.
// Secrets.kt is gitignored and will not be committed.

package com.meta.wearable.dat.externalsampleapps.cameraaccess

object Secrets {
    // Hosted gateway that mints LiveKit room tickets. Point this at your own
    // deployment -- see gateway/README.md. Leave the token empty: it is
    // per-person identity, entered in the app on first launch (baking one in
    // would make every install the same user).
    const val gatewayBaseUrl = "https://api.visionagents.app"
    const val gatewayToken = ""

    // OpenClaw direct connection (alternative to the hosted gateway).
    // Talks to an OpenClaw instance's /v1/chat/completions endpoint.
    // The session key routes messages to a specific agent.
    //   agent:cto:glass → Spock (CTO)
    //   agent:coo:glass → Wren (COO)
    //   agent:cmo:glass → Mason (CMO)
    //   agent:cro:glass → Grayson (CRO)
    const val openClawBaseUrl = "https://openclaw.wembassy.com"
    const val openClawToken = "YOUR_OPENCLAW_GATEWAY_TOKEN"
    const val openClawSessionKey = "agent:coo:glass"
}